# ============================================================================
# Voice-Enabled RAG - environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Sarvam AI - Speech-to-Text (Saaras v3). https://dashboard.sarvam.ai/
# Required for the /api/voice path. The /api/query text path works without it.
SARVAM_API_KEY="sk_mzolbn1q_8CnScAzbszm29tOLeAn5lVJG"

# Groq - LLM generation. https://console.groq.com/keys
# Required for answer generation. Without it the pipeline FAILS CLOSED
# (abstains) rather than fabricating an answer.
GROQ_API_KEY="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"

# Qdrant Cloud API key. Leave empty for a local/dockerised Qdrant.
QDRANT_API_KEY=

# Optional: Hugging Face token. Only needed for gated repos / higher rate
# limits. MSMARCO-XI and BAAI/bge-m3 are public, so this can stay empty.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Ingestion / corpus  (see §"Corpus modes" in README)
# ---------------------------------------------------------------------------
DATASET_ID=ai4bharat/MSMARCO-XI
DATASET_SPLIT=train

# ISO-639-1 codes. The loader maps these to the dataset's 3-letter filenames
# (hi -> hintrain.parquet, mr -> martrain.parquet, ...).
# NOTE: Telugu (te) has NO train file upstream - it exists only in validation.
LANGUAGES=hi,mr,ta,te

# INGEST_MODE selects a profile from configs/{dev,demo,full}.yaml
#   dev  -> tiny, fast local iteration
#   demo -> bounded low-latency demo corpus (default)
#   full -> large offline ingestion run
INGEST_MODE=demo
MAX_ROWS_PER_LANGUAGE=

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=msmarco_xi
# If Qdrant server is unreachable, fall back to an embedded on-disk client.
QDRANT_LOCAL_PATH=.qdrant_local
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_S=10.0

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7

# Pinned commit SHAs (set to "main" to track upstream).
# BGE-M3's sparse head (sparse_linear.pt) is fetched separately from the
# backbone weights. If `main` moves between those two fetches, the head and the
# encoder come from different commits and the sparse retrieval branch is
# silently wrong. Pinning also keeps benchmark numbers reproducible.
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
NLI_MODEL_REVISION=b5113eb38ab63efdd7f280f8c144ea8b13f978ce

# cpu | cuda | auto
DEVICE=auto
# fp16 is only enabled on CUDA; ignored on CPU (unsafe/slow there).
USE_FP16=true
# Cap intra-op threads so latency is stable and reproducible.
TORCH_NUM_THREADS=8

# Where transformers/HF caches models. Kept off C: by default because the
# three models total roughly 5 GB.
HF_HOME=.hf_cache

# ---------------------------------------------------------------------------
# Generation (Groq)
# ---------------------------------------------------------------------------
# As of 2026-08, llama-3.1-8b-instant / llama-3.3-70b-versatile are DEPRECATED.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_S=20.0
GROQ_MAX_RETRIES=1
GROQ_TEMPERATURE=0.0
# Voice answers are kept short so completion latency is predictable.
GROQ_MAX_TOKENS=320

# ---------------------------------------------------------------------------
# Speech-to-text (Sarvam Saaras v3)
# ---------------------------------------------------------------------------
SARVAM_STT_MODEL=saaras:v3
# The Saaras v3 STREAMING endpoint is /speech-to-text/ws.
# Do NOT point this at /speech-to-text-translate/ws: that is the translate
# endpoint, it force-translates output to English, and it kept saaras:v2.5 for
# backward compatibility.
SARVAM_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_REST_URL=https://api.sarvam.ai/speech-to-text
# transcribe | translate | verbatim | translit | codemix
# transcribe keeps the source language + script (required for Indic retrieval).
SARVAM_STT_MODE=transcribe
# "unknown" => auto-detect language AND return language_probability.
SARVAM_LANGUAGE_CODE=unknown
SARVAM_SAMPLE_RATE=16000
SARVAM_HIGH_VAD_SENSITIVITY=true
SARVAM_VAD_SIGNALS=true
SARVAM_TIMEOUT_S=15.0
SARVAM_MAX_RETRIES=2
# Fall back to the REST endpoint when the streaming socket fails.
SARVAM_ENABLE_REST_FALLBACK=true

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
DENSE_TOP_K=30
SPARSE_TOP_K=30
RRF_TOP_K=30
RERANK_TOP_K=30
FINAL_TOP_K=5
# Retrieve against child chunks, generate from parent passages.
ENABLE_PARENT_EXPANSION=true
# Language filter is applied only when detection confidence clears this bar.
LANGUAGE_FILTER_CONFIDENCE=0.65

# ---------------------------------------------------------------------------
# Guardrails / abstention
# Thresholds are CALIBRATED, not guessed. Run:
#   python scripts/calibrate_thresholds.py
# which writes configs/thresholds.json. These are only bootstrap defaults.
# ---------------------------------------------------------------------------
THRESHOLDS_PATH=configs/thresholds.json
ENABLE_NLI_GROUNDING=true
NLI_ENTAILMENT_THRESHOLD=0.5
# Skip NLI when the answer is a verbatim/near-verbatim span of the context.
NLI_SKIP_ON_DETERMINISTIC_GROUNDING=true
ENABLE_DEEP_SAFETY_CHECK=false

# ---------------------------------------------------------------------------
# Server / observability
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Never log full transcripts/audio in production.
LOG_REQUEST_BODIES=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
